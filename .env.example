# Database
DATABASE_URL=postgresql://postgres:postgres@db:5432/gbpdb

# Redis
REDIS_URL=redis://redis:6379

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Server
PORT=3000
NODE_ENV=development

# Mock Services (set to false in production)
USE_MOCK_SERVICES=true

# Log Level
LOG_LEVEL=info

# Google API (Phase 2)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=

# LINE API (Phase 2)
# LINE_CHANNEL_ID=
# LINE_CHANNEL_SECRET=
# LINE_CHANNEL_ACCESS_TOKEN=
